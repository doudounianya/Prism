<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<!--日志按日期和大小分卷，仅清理 CRT_HMI 前缀的历史日志；旧日期日志保留。-->
		<target name="f"
				xsi:type="File"
				fileName="${basedir}/logs/CRT_HMI-${shortdate}.log"
				archiveAboveSize="20971520"
				archiveSuffixFormat="_{0:00}"
				maxArchiveFiles="100"
				maxArchiveDays="30"
				layout="${longdate} ${uppercase:${level}} ${message}${onexception:inner=${newline}${exception:format=tostring}}" />
	</targets>
	<rules>
		<!--日志路由规则：最低级别Debug，输出到target目标f-->
		<logger name="*" minlevel="Debug" writeTo="f" />
	</rules>
</nlog>
