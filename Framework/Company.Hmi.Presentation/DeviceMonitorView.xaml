<hmi:BusinessPage xmlns:hmi="clr-namespace:Company.Hmi.Presentation" x:Class="Company.Hmi.Presentation.DeviceMonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   FontSize="16" Background="#F0F5FB">
 <hmi:BusinessPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Company.Hmi.Presentation;component/ComponentPageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></hmi:BusinessPage.Resources>
 <Grid Margin="20"><Border Background="White" CornerRadius="6" BorderBrush="#DAE5F1" BorderThickness="1">
  <DataGrid ItemsSource="{Binding Devices}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="48">
   <DataGrid.Columns>
    <DataGridTextColumn Header="设备" Binding="{Binding Device,Mode=OneWay}" Width="180"/>
    <DataGridTextColumn Header="通讯状态" Binding="{Binding State,Mode=OneWay}" Width="240"/>
    <DataGridTextColumn Header="最近通讯成功时间" Binding="{Binding LastSuccess,Mode=OneWay}" Width="260"/>
    <DataGridTextColumn Header="通讯信息" Binding="{Binding Error,Mode=OneWay}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
 </Border></Grid>
</hmi:BusinessPage>
