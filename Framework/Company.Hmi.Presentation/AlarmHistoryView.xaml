<hmi:BusinessPage xmlns:hmi="clr-namespace:Company.Hmi.Presentation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"   xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Class="Company.Hmi.Presentation.AlarmHistoryView"  Background="#F0F5FB" FontFamily="Segoe UI, Microsoft YaHei" FontSize="15">
  <hmi:BusinessPage.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Company.Hmi.Presentation;component/ComponentPageStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </hmi:BusinessPage.Resources>
  <Grid Margin="20,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="#DAE5F1" BorderThickness="0,0,0,1" Margin="0,0,0,14" Grid.Row="0">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource SubnavButton}" Content="实时报警" Tag="" hmi:BusinessPage.PageTarget="RealtimeAlarmView"/>
        <Button Style="{StaticResource SubnavButton}" Content="历史报警" Tag="current" hmi:BusinessPage.PageTarget="AlarmHistoryView"/>
        <Button Style="{StaticResource SubnavButton}" Content="报警分析" Tag="" hmi:BusinessPage.PageTarget="AlarmAnalysisView"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Toolbar}" Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="AlarmQueryFilters" MinWidth="1010">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*" MinWidth="255"/>
            <ColumnDefinition Width="2.1*" MinWidth="255"/>
            <ColumnDefinition Width="1*" MinWidth="130"/>
            <ColumnDefinition Width="1.5*" MinWidth="160"/>
            <ColumnDefinition Width="110" MinWidth="110"/>
            <ColumnDefinition Width="100" MinWidth="100"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Style="{StaticResource AlarmFilterField}" Margin="0,0,12,6">
            <TextBlock Text="开始时间（含）" Style="{StaticResource AlarmFilterLabel}"/>
            <Border Style="{StaticResource DateTimeField}" Height="40">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1"/>
                  <ColumnDefinition Width="95"/>
                </Grid.ColumnDefinitions>
                <DatePicker Style="{StaticResource InlineDatePicker}" Height="38" SelectedDate="{Binding Filter.FromDate}"/>
                <Border Grid.Column="1" Background="#DAE5F1" Margin="0,7"/>
                <TextBox Grid.Column="2" Style="{StaticResource InlineTimeInput}" Height="38" Text="{Binding Filter.FromTime,UpdateSourceTrigger=PropertyChanged}" ToolTip="24小时制：HH:mm:ss" MaxLength="8"/>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Style="{StaticResource AlarmFilterField}" Margin="0,0,12,6">
            <TextBlock Text="结束时间（不含）" Style="{StaticResource AlarmFilterLabel}"/>
            <Border Style="{StaticResource DateTimeField}" Height="40">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1"/>
                  <ColumnDefinition Width="95"/>
                </Grid.ColumnDefinitions>
                <DatePicker Style="{StaticResource InlineDatePicker}" Height="38" SelectedDate="{Binding Filter.ToDate}"/>
                <Border Grid.Column="1" Background="#DAE5F1" Margin="0,7"/>
                <TextBox Grid.Column="2" Style="{StaticResource InlineTimeInput}" Height="38" Text="{Binding Filter.ToTime,UpdateSourceTrigger=PropertyChanged}" ToolTip="24小时制：HH:mm:ss" MaxLength="8"/>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Style="{StaticResource AlarmFilterField}" Margin="0,0,12,6">
            <TextBlock Text="报警等级" Style="{StaticResource AlarmFilterLabel}"/>
            <ComboBox Style="{StaticResource AlarmFilterSelect}" IsEditable="True" ItemsSource="{Binding Filter.Severities}" Text="{Binding Filter.Severity,UpdateSourceTrigger=PropertyChanged}" ToolTip="留空查询全部等级；也可输入配置中的等级"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Style="{StaticResource AlarmFilterField}" Margin="0,0,12,6">
            <TextBlock Text="关键词" Style="{StaticResource AlarmFilterLabel}"/>
            <TextBox Style="{StaticResource AlarmFilterInput}" MaxLength="256" Text="{Binding Filter.Keyword,UpdateSourceTrigger=PropertyChanged}" ToolTip="查询报警码、说明或构件；留空查询全部"/>
          </StackPanel>
          <StackPanel Grid.Column="4" Style="{StaticResource AlarmFilterField}" Margin="0,0,12,6">
            <TextBlock Text="每页条数" Style="{StaticResource AlarmFilterLabel}"/>
            <ComboBox Style="{StaticResource AlarmFilterSelect}" ItemsSource="{Binding Filter.PageSizes}" SelectedItem="{Binding Filter.PageSize}"/>
          </StackPanel>
          <StackPanel Grid.Column="5" Style="{StaticResource AlarmFilterField}" Margin="0,0,0,6">
            <TextBlock Text="操作" Style="{StaticResource AlarmFilterLabel}"/>
            <!-- 查询与取消使用同一位置，避免工具栏新增宽度或出现第二行。 -->
            <Button Height="40" Width="100" Margin="0" HorizontalAlignment="Left" ToolTip="{Binding Status}">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Primary}">
                <Setter Property="Content" Value="查询"/><Setter Property="Command" Value="{Binding QueryCommand}"/><Setter Property="IsEnabled" Value="{Binding CanQuery}"/>
                <Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Content" Value="取消查询"/><Setter Property="Command" Value="{Binding CancelCommand}"/><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers>
              </Style></Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
    <Border Style="{StaticResource Panel}" Grid.Row="2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PanelHead}" Grid.Row="0">
          <TextBlock Text="历史报警记录" Style="{StaticResource SectionTitle}"/>
        </Border>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}" MinHeight="0" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Grid.Row="1" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="等级" Binding="{Binding Severity}" Width="70"/>
            <DataGridTextColumn Header="报警 / 部件" Binding="{Binding Alarm}" Width="130"/>
            <DataGridTextColumn Header="报警信息" Binding="{Binding Description}" Width="*" MinWidth="160"/>
            <DataGridTextColumn Header="开始时间" Binding="{Binding StartText}" Width="210"/>
            <DataGridTextColumn Header="结束时间" Binding="{Binding EndText}" Width="210"/>
            <DataGridTextColumn Header="时长" Binding="{Binding ObservedDuration}" Width="156"/>
          </DataGrid.Columns>
        </DataGrid>
        <DockPanel Margin="12,10" Grid.Row="2">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource StableStateButton}" Content="上一页" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/>
            <Button Style="{StaticResource StableStateButton}" Content="下一页" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/>
          </StackPanel>
          <TextBlock Text="{Binding Paging}" Style="{StaticResource Muted}"/>
        </DockPanel>
      </Grid>
    </Border>
    <Expander Header="所选事件详情与有效观察片段" Margin="0,12,0,0" MaxHeight="240" Grid.Row="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource Panel}" Padding="14">
          <StackPanel>
            <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DetailSummary}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding DetailDefinition}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ItemsControl ItemsSource="{Binding Segments}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Expander>
    <Border Style="{StaticResource Note}" Grid.Row="4">
      <TextBlock Text="只查询已保存记录；无记录不代表无报警。未知区间不补时长。" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</hmi:BusinessPage>
