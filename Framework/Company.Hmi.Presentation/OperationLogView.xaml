<hmi:BusinessPage xmlns:hmi="clr-namespace:Company.Hmi.Presentation" x:Class="Company.Hmi.Presentation.OperationLogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

 Background="#F0F5FB" FontFamily="Segoe UI, Microsoft YaHei" FontSize="15">
 <hmi:BusinessPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Company.Hmi.Presentation;component/ComponentPageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></hmi:BusinessPage.Resources>
 <Grid Margin="20,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Toolbar}">
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
     <TextBlock Text="开始日期" Margin="0,0,8,0"/><DatePicker Width="160" Height="40" SelectedDate="{Binding FromDate}" Margin="0,0,16,0"/>
     <TextBlock Text="结束日期" Margin="0,0,8,0"/><DatePicker Width="160" Height="40" SelectedDate="{Binding ToDate}" Margin="0,0,16,0"/>
     <TextBlock Text="用户名" Margin="0,0,8,0"/><TextBox Width="150" Height="40" MaxLength="64" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
     <TextBlock Text="操作关键词" Margin="0,0,8,0"/><TextBox Width="220" Height="40" MaxLength="128" Text="{Binding Keyword,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
     <Button Height="40"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Content" Value="查询"/><Setter Property="Command" Value="{Binding QueryCommand}"/><Setter Property="IsEnabled" Value="{Binding CanQuery}"/>
      <Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Content" Value="取消查询"/><Setter Property="Command" Value="{Binding CancelCommand}"/><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers>
     </Style></Button.Style></Button>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
     <DataGrid.Columns>
      <DataGridTextColumn Header="时间" Binding="{Binding Time,Mode=OneWay}" Width="210"/>
      <DataGridTextColumn Header="用户名" Binding="{Binding UserName,Mode=OneWay}" Width="130"/>
      <DataGridTextColumn Header="设备" Binding="{Binding Device,Mode=OneWay}" Width="110"/>
      <DataGridTextColumn Header="操作对象" Binding="{Binding ComponentName,Mode=OneWay}" Width="210"/>
      <DataGridTextColumn Header="操作内容" Binding="{Binding Operation,Mode=OneWay}" Width="2*" MinWidth="230"/>
      <DataGridTextColumn Header="数值变化" Binding="{Binding Changes,Mode=OneWay}" Width="3*" MinWidth="260">
       <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Changes}"/></Style></DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
      <DataGridTextColumn Header="通讯结果" Binding="{Binding Result,Mode=OneWay}" Width="130"/>
     </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
     <TextBlock Text="{Binding Paging}" DockPanel.Dock="Left"/>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="上一页" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/><Button Content="下一页" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/></StackPanel>
    </DockPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding LogNote, FallbackValue=通讯写入成功不代表设备动作完成。记录沿用软件日志保存期限。}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
  </StackPanel>
 </Grid>
</hmi:BusinessPage>
