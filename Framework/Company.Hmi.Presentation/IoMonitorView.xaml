<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Company.Hmi.Presentation.IoMonitorView" Background="#F0F5FB" FontFamily="Segoe UI, Microsoft YaHei" FontSize="15">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="IoMonitorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18">
            <Border Style="{StaticResource Toolbar}">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                        <TextBlock Text="设备" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="130"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                        <TextBlock Text="信号类型" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox ItemsSource="{Binding SignalTypes}" SelectedItem="{Binding SelectedSignalType}" Width="85"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                        <TextBlock Text="分组" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Width="75"/>
                    </StackPanel>
                </WrapPanel>
            </Border>
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <TextBlock Text="信号区域" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding SelectedSignalType}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="只读监视" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <TextBlock Text="当前分组" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding SelectedGroup}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="每组 16 个点位" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <TextBlock Text="ON 点数" Style="{StaticResource Muted}"/>
                        <TextBlock Style="{StaticResource MetricValue}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Projection}" ConverterParameter="ioOn">
                                    <Binding Path="Items"/>
                                    <Binding Path="Summary"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="ON 表示位值，不代表安全状态" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <TextBlock Text="数据质量" Style="{StaticResource Muted}"/>
                        <TextBlock Style="{StaticResource MetricValue}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Projection}" ConverterParameter="ioQuality">
                                    <Binding Path="Items"/>
                                    <Binding Path="Summary"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="未知不会替换为 OFF" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="255"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <DataGrid x:Name="Signals" MinHeight="420" SelectedIndex="0" ItemsSource="{Binding Items}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="65"/>
                                    <DataGridTextColumn Header="逻辑地址" Binding="{Binding LogicalId}" Width="155"/>
                                    <DataGridTextColumn Header="信号名称" Binding="{Binding DisplayName}" Width="*" MinWidth="160"/>
                                    <DataGridTemplateColumn Header="状态" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Indicator, Converter={StaticResource Indicator}}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding StateText}" Foreground="{Binding Indicator, Converter={StaticResource Indicator}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Style="{StaticResource PanelHead}" BorderThickness="0,1,0,0">
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ContentControl Grid.Column="2" HorizontalContentAlignment="Stretch">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHead}">
                                <TextBlock Text="信号详情" Style="{StaticResource SectionTitle}"/>
                            </Border>
                            <StackPanel Margin="14">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="信号" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.DisplayName,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="逻辑地址" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.LogicalId,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="状态" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.StateText,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="数据质量" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.QualityText,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="更新时间" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.UpdatedText,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="上次有效值（历史）" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.LastValueText,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding BindingLabel}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.BindingDetails,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="错误说明" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SelectedItem.Error,ElementName=Signals}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Style="{StaticResource Note}">
                                    <TextBlock Text="{Binding ReadOnlyNotice}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ContentControl>
            </Grid>
            <Border Style="{StaticResource Note}">
                <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
