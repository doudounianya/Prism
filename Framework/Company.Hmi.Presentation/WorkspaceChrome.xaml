<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WorkspaceNavigationActiveBackground" Color="#EDF5FF"/>
    <SolidColorBrush x:Key="WorkspaceNavigationActiveForeground" Color="#1264D9"/>
    <SolidColorBrush x:Key="WorkspaceNavigationUnderline" Color="#186AE8"/>
    <SolidColorBrush x:Key="WorkspaceNavigationDisabledForeground" Color="#71859D"/>

    <Style x:Key="WorkspaceNavigationItem" TargetType="Control">
        <Setter Property="Width" Value="108"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="WorkspaceNavigationLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#214368"/>
    </Style>

    <Style x:Key="WorkspaceHeaderFrame" TargetType="Border">
        <Setter Property="Background" Value="#FAFCFF"/>
        <Setter Property="BorderBrush" Value="#DAE5F1"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,0,14,12"/>
    </Style>

    <Style x:Key="WorkspaceProductTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#10365D"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="WorkspaceProductDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#71859D"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
    </Style>

    <Style x:Key="WorkspaceStatusBar" TargetType="Border">
        <Setter Property="Background" Value="#1565DF"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="38"/>
    </Style>

    <Style x:Key="WorkspaceStatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="WorkspaceDiagnosticsFrame" TargetType="Border">
        <Setter Property="Background" Value="#F6F9FD"/>
        <Setter Property="BorderBrush" Value="#DAE5F1"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>
</ResourceDictionary>
