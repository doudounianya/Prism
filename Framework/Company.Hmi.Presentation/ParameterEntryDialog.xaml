<Window x:Class="Company.Hmi.Presentation.ParameterEntryDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="参数输入" Width="460" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F0F5FB"
 FontFamily="Segoe UI, Microsoft YaHei" FontSize="16">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ComponentPageStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Height" Value="58"/><Setter Property="FontSize" Value="26"/>
    <Setter Property="Margin" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <StackPanel Margin="24">
  <TextBlock x:Name="ParameterName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="Input" Height="60" FontSize="28" Padding="12,0" VerticalContentAlignment="Center" MaxLength="160" TextChanged="InputChanged">
    <TextBox.Template><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="#1765D2" BorderThickness="1" CornerRadius="4"><ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/></Border></ControlTemplate></TextBox.Template>
   </TextBox>
   <TextBlock x:Name="Unit" Grid.Column="1" Margin="10,0,0,0" FontSize="15"/>
  </Grid>
  <TextBlock x:Name="WriteAvailability" Visibility="Collapsed" Foreground="#996419" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
  <TextBlock x:Name="InputError" Foreground="#C53D35" TextWrapping="Wrap" MinHeight="32" Margin="0,8,0,0"/>
  <UniformGrid x:Name="Keypad" Columns="3" Margin="-4,0,-4,8">
   <Button Content="7" Style="{StaticResource KeyButton}" Click="DigitClicked"/><Button Content="8" Style="{StaticResource KeyButton}" Click="DigitClicked"/><Button Content="9" Style="{StaticResource KeyButton}" Click="DigitClicked"/>
   <Button Content="4" Style="{StaticResource KeyButton}" Click="DigitClicked"/><Button Content="5" Style="{StaticResource KeyButton}" Click="DigitClicked"/><Button Content="6" Style="{StaticResource KeyButton}" Click="DigitClicked"/>
   <Button Content="1" Style="{StaticResource KeyButton}" Click="DigitClicked"/><Button Content="2" Style="{StaticResource KeyButton}" Click="DigitClicked"/><Button Content="3" Style="{StaticResource KeyButton}" Click="DigitClicked"/>
   <Button Content="±" Style="{StaticResource KeyButton}" Click="SignClicked"/><Button Content="0" Style="{StaticResource KeyButton}" Click="DigitClicked"/><Button Content="." Style="{StaticResource KeyButton}" Click="DigitClicked"/>
  </UniformGrid>
  <UniformGrid x:Name="EditKeys" Columns="2" Margin="0,0,0,14">
   <Button Content="清空" FontSize="15" Height="40" HorizontalContentAlignment="Center" Click="ClearClicked"/>
   <Button Content="退格" FontSize="15" Height="40" Margin="7,0,0,0" HorizontalContentAlignment="Center" Click="BackspaceClicked"/>
  </UniformGrid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button Content="取消" IsCancel="True" Height="44" FontSize="16" Margin="0" HorizontalContentAlignment="Center"/>
   <Button x:Name="ConfirmButton" Grid.Column="2" Content="确定" IsDefault="True" Style="{StaticResource Primary}" Height="44" FontSize="16" Margin="0" HorizontalContentAlignment="Center" Click="ConfirmClicked"/>
  </Grid>
 </StackPanel>
</Window>
