<UserControl x:Class="Company.Hmi.Presentation.SettingsPage" x:Name="Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F5FB" FontFamily="Segoe UI, Microsoft YaHei">
    <UserControl.Resources>
        <ResourceDictionary Source="/Company.Hmi.Presentation;component/SettingsPageStyles.xaml"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="软件设置">
                <ContentPresenter Content="{Binding SoftwareContent, ElementName=Settings}"/>
            </TabItem>
            <TabItem Header="账号设置">
                <ContentPresenter Content="{Binding AccountContent, ElementName=Settings}"/>
            </TabItem>
        </TabControl>
        <ContentPresenter Grid.Row="1" Content="{Binding Actions, ElementName=Settings}"/>
    </Grid>
</UserControl>
