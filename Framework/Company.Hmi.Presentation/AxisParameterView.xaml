<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Company.Hmi.Presentation" xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Class="Company.Hmi.Presentation.AxisParameterView" Background="#F0F5FB" FontFamily="Segoe UI, Microsoft YaHei" FontSize="15">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ComponentPageStyles.xaml"/></ResourceDictionary.MergedDictionaries><Style x:Key="AxisInputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
 <Setter Property="IsReadOnly" Value="True"/><Setter Property="Text" Value="{Binding Edit.Draft,Mode=OneWay}"/>
 <Setter Property="IsEnabled" Value="True"/><Setter Property="ToolTip" Value="{Binding Edit.Result}"/>
 <Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="65"/><Setter Property="FontSize" Value="22"/>
 <Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Foreground" Value="#223E5E"/><Setter Property="Opacity" Value="1"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
  <Border x:Name="InputFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
   <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Padding="0" Margin="0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/>
  </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="#1765D2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="#1765D2"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
 <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,4,0"/>
 <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ParameterPressed"/><EventSetter Event="PreviewKeyDown" Handler="ParameterKeyDown"/>
</Style>
<Style x:Key="AxisActionButton" TargetType="Button" BasedOn="{StaticResource StableStateButton}">
 <Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="4"/>
 <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>
<Style x:Key="AxisManualButton" TargetType="Button" BasedOn="{StaticResource AxisActionButton}">
 <Setter Property="MinHeight" Value="44"/>
 <Setter Property="IsEnabled" Value="{Binding DataContext.CanUseControls,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
 <Setter Property="ToolTip" Value="{Binding CommandParameter.State,RelativeSource={RelativeSource Self},FallbackValue=状态未就绪,TargetNullValue=状态未就绪}"/>
 <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#223E5E"/>
 <Style.Triggers>
  <DataTrigger Binding="{Binding CommandParameter.DisplayBooleanValue,RelativeSource={RelativeSource Self},FallbackValue={x:Null},TargetNullValue={x:Null}}" Value="True"><Setter Property="Background" Value="#159947"/><Setter Property="BorderBrush" Value="#159947"/><Setter Property="Foreground" Value="White"/></DataTrigger>
  <DataTrigger Binding="{Binding CommandParameter.DisplayBooleanValue,RelativeSource={RelativeSource Self},FallbackValue={x:Null},TargetNullValue={x:Null}}" Value="False"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DAE5F1"/><Setter Property="Foreground" Value="#223E5E"/></DataTrigger>
  <DataTrigger Binding="{Binding CommandParameter.BooleanValue,RelativeSource={RelativeSource Self},FallbackValue={x:Null},TargetNullValue={x:Null}}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
 </Style.Triggers>
</Style>
<Style x:Key="AxisRunButton" TargetType="Button" BasedOn="{StaticResource StableStateButton}">
 <Setter Property="Content" Value="运行"/>
 <Setter Property="Width" Value="120"/><Setter Property="MinWidth" Value="120"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="15"/>
 <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
 <Setter Property="IsEnabled" Value="{Binding DataContext.CanUseControls,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
 <Setter Property="ToolTip" Value="{Binding RunState.State}"/>
 <Style.Triggers>
  <DataTrigger Binding="{Binding RunState.DisplayBooleanValue}" Value="True"><Setter Property="Background" Value="#159947"/><Setter Property="BorderBrush" Value="#159947"/><Setter Property="Foreground" Value="White"/><Setter Property="ToolTip" Value="运行位 True · 点击写入 False"/></DataTrigger>
  <DataTrigger Binding="{Binding RunState.DisplayBooleanValue}" Value="False"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DAE5F1"/><Setter Property="Foreground" Value="#223E5E"/><Setter Property="ToolTip" Value="运行位 False · 点击写入 True"/></DataTrigger>
  <DataTrigger Binding="{Binding RunState.BooleanValue}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
 </Style.Triggers>
</Style>
<DataTemplate x:Key="AxisPositionInputCell"><TextBox Style="{StaticResource AxisInputBox}" VerticalAlignment="Center"/></DataTemplate>
<DataTemplate x:Key="AxisElapsedCell"><TextBlock Text="{Binding Value}" FontSize="20" VerticalAlignment="Center"/></DataTemplate>
<DataTemplate x:Key="PositionHeader"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeading}" Text="{Binding DataContext.PositionColumnTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/><TextBlock Style="{StaticResource ColumnHeading}" Text="{Binding DataContext.PositionUnit,RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></DataTemplate>
<DataTemplate x:Key="SpeedHeader"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeading}" Text="速度"/><TextBlock Style="{StaticResource ColumnHeading}" Text="{Binding DataContext.SpeedUnit,RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></DataTemplate>
<DataTemplate x:Key="AccelerationHeader"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeading}" Text="加速度"/><TextBlock Style="{StaticResource ColumnHeading}" Text="{Binding DataContext.AccelerationUnit,RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></DataTemplate>
<DataTemplate x:Key="DecelerationHeader"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ColumnHeading}" Text="减速度"/><TextBlock Style="{StaticResource ColumnHeading}" Text="{Binding DataContext.DecelerationUnit,RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="5,0,0,0"/></StackPanel></DataTemplate>
<Style x:Key="SignalLamp" TargetType="Ellipse"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Fill" Value="#BCC7D3"/><Setter Property="ToolTip" Value="{Binding Tag.State,RelativeSource={RelativeSource Self},FallbackValue=未配置,TargetNullValue=未配置}"/><Style.Triggers><DataTrigger Binding="{Binding Tag.DisplayBooleanValue,RelativeSource={RelativeSource Self},FallbackValue={x:Null},TargetNullValue={x:Null}}" Value="True"><Setter Property="Fill" Value="#159947"/></DataTrigger><DataTrigger Binding="{Binding Tag.DisplayBooleanValue,RelativeSource={RelativeSource Self},FallbackValue={x:Null},TargetNullValue={x:Null}}" Value="False"><Setter Property="Fill" Value="#8795A4"/></DataTrigger></Style.Triggers></Style>
<DataTemplate x:Key="MetricValue"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Value,FallbackValue=—,TargetNullValue=—}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="6,0,0,2" FontSize="15" Foreground="#627A94"/></StackPanel></DataTemplate>
<DataTemplate x:Key="PowerValue"><TextBlock FontSize="22" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="—"/><Style.Triggers><DataTrigger Binding="{Binding DisplayBooleanValue}" Value="True"><Setter Property="Text" Value="已使能"/></DataTrigger><DataTrigger Binding="{Binding DisplayBooleanValue}" Value="False"><Setter Property="Text" Value="未使能"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
<DataTemplate x:Key="HomeValue"><TextBlock FontSize="22" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="—"/><Style.Triggers><DataTrigger Binding="{Binding DisplayBooleanValue}" Value="True"><Setter Property="Text" Value="已回原点"/></DataTrigger><DataTrigger Binding="{Binding DisplayBooleanValue}" Value="False"><Setter Property="Text" Value="未回原点"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
<Style x:Key="AxisPositionTabStrip" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Border BorderBrush="#DAE5F1" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="AxisPositionTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
 <Setter Property="Width" Value="120"/><Setter Property="Height" Value="48"/><Setter Property="MinWidth" Value="120"/><Setter Property="Margin" Value="0,0,8,0"/>
 <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid Background="Transparent"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/><Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="Transparent"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#1765D2"/><Setter TargetName="Indicator" Property="Background" Value="#1765D2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="AxisAbsoluteTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
<Style x:Key="AxisRelativeTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
</ResourceDictionary></UserControl.Resources>
