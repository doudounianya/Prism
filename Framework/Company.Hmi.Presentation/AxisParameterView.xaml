<Border Background="White" BorderBrush="#DAE5F1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4" MinHeight="82"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E56C22" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="原点状态" Foreground="#627A94" FontSize="15" Margin="0,0,0,4"/><ContentControl Content="{Binding OriginState}" ContentTemplate="{StaticResource HomeValue}"/></StackPanel></Grid></Border>
<Border Background="White" BorderBrush="#DAE5F1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4" MinHeight="82"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#1765D2" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="报警代码" Foreground="#627A94" FontSize="15" Margin="0,0,0,4"/><ContentControl Content="{Binding ErrorCode}" ContentTemplate="{StaticResource MetricValue}"/></StackPanel></Grid></Border>
