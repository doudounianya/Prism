<UserControl x:Class="Company.Application.Main.Views.ModeControlView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Company.Application.Main.Presentation"
 xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True"
 ui:ModePressButton.Pressed="InitializationPressed" ui:ModePressButton.Released="InitializationReleased"
 FontFamily="Segoe UI, Microsoft YaHei" FontSize="16" Background="#F0F5FB">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Company.Application.Main;component/Presentation/PreviewPageStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <!-- 实心蓝底表示PLC实际模式/急停；细边框及下划线仅表示当前查看，不控制设备。 -->
   <Style x:Key="ModeTab" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="140"/><Setter Property="MinHeight" Value="46"/>
    <Setter Property="Padding" Value="20,10"/><Setter Property="Margin" Value="0,0,10,0"/>
    <Setter Property="FontSize" Value="17"/><Setter Property="Foreground" Value="#627A94"/>
    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DAE5F1"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
     <Grid><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border><Border x:Name="ViewingMarker" Height="3" Background="{TemplateBinding Foreground}" Margin="12,0,12,3" VerticalAlignment="Bottom" Visibility="Collapsed"/></Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="ViewingMarker" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#104E9C"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#1765D2"/><Setter Property="BorderBrush" Value="#1765D2"/></Trigger></Style.Triggers>
   </Style>
   <Style x:Key="ManualModeTab" TargetType="RadioButton" BasedOn="{StaticResource ModeTab}"><Style.Triggers><DataTrigger Binding="{Binding Display.Mode}" Value="0"><Setter Property="Background" Value="#1765D2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#104E9C"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="AutomaticModeTab" TargetType="RadioButton" BasedOn="{StaticResource ModeTab}"><Style.Triggers><DataTrigger Binding="{Binding Display.Mode}" Value="20"><Setter Property="Background" Value="#1765D2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#104E9C"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="MaintenanceModeTab" TargetType="RadioButton" BasedOn="{StaticResource ModeTab}"><Style.Triggers><DataTrigger Binding="{Binding Display.Mode}" Value="10"><Setter Property="Background" Value="#1765D2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#104E9C"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style>
   <Style x:Key="EmergencyModeTab" TargetType="RadioButton" BasedOn="{StaticResource ModeTab}"><Style.Triggers><DataTrigger Binding="{Binding Display.Status}" Value="70"><Setter Property="Background" Value="#1765D2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#104E9C"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style>
   <DataTemplate x:Key="ModeSignalRow">
    <!-- 全部为只读显示，不复用操作按钮，避免把物理输入和 PLC 信号误认为可以点击。 -->
    <Grid Margin="0,2,8,2" MinHeight="44" ToolTip="{Binding Details}" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Name}" FontSize="16" Foreground="#31465D" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
     <Border Grid.Column="1" CornerRadius="4" Padding="8,4" MinWidth="72" BorderThickness="1" VerticalAlignment="Center">
      <Border.Style><Style TargetType="Border">
       <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#A8B5C4"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Background" Value="#1765D2"/><Setter Property="BorderBrush" Value="#104E9C"/></DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <TextBlock Text="{Binding ValueText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center">
       <TextBlock.Style><Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#526171"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
     </Border>
     <!-- 读取质量和时间保留在详情提示中；不在每行重复“有效读取”，让全部反馈保持统一行距。 -->
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="ModeRequestRow">
    <!-- 值和质量仍是只读反馈，右侧独立按钮复用已有命令入口，便于触摸操作。 -->
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ModeSignalRow}"/>
     <Button Grid.Column="1" Click="InterfaceActionClicked" MinWidth="116" MinHeight="44" Padding="6,4" FontSize="16" Margin="8,2,0,2" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StableStateButton}">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Suffix}" Value="Action[6]">
         <Setter Property="Visibility" Value="Visible"/><Setter Property="Content" Value="调试开关"/>
         <Setter Property="IsEnabled" Value="{Binding DataContext.CanToggleDebug,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
         <Setter Property="ToolTip" Value="点击进入或退出调试。进入时需实际处于手动模式、停止状态，且当前有效急停信号 b_Signal[5]=False；查看页签不会切换设备模式。"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Suffix}" Value="Action[7]">
         <Setter Property="Visibility" Value="Visible"/><Setter Property="Content" Value="按住初始化"/>
         <Setter Property="ui:ModePressButton.UseHold" Value="True"/>
         <Setter Property="IsEnabled" Value="{Binding DataContext.CanRequestInitialization,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
         <Setter Property="ToolTip" Value="按下写 True，松开写 False。需实际处于手动模式、停止状态，且当前有效急停信号 b_Signal[5]=False。"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Suffix}" Value="Action[8]">
         <Setter Property="Visibility" Value="Visible"/><Setter Property="Content" Value="人员锁管理"/>
         <Setter Property="ToolTip" Value="打开人员锁管理，由本人验证上锁、解锁，或管理员验证后解除全部锁。"/>
        </DataTrigger>
       </Style.Triggers>
      </Style></Button.Style>
     </Button>
    </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="20,16,20,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="200"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <RadioButton x:Name="ManualTab" Style="{StaticResource ManualModeTab}" GroupName="ModeDiagram" Content="手动模式" Tag="Manual" IsChecked="True" Checked="ModeTabChecked" ToolTip="实心蓝底：PLC实际模式；下划线：当前查看的图。点击只切换查看。"/>
    <RadioButton x:Name="AutomaticTab" Style="{StaticResource AutomaticModeTab}" GroupName="ModeDiagram" Content="自动模式" Tag="Automatic" Checked="ModeTabChecked" ToolTip="实心蓝底：PLC实际模式；下划线：当前查看的图。点击只切换查看。"/>
    <RadioButton x:Name="MaintenanceTab" Style="{StaticResource MaintenanceModeTab}" GroupName="ModeDiagram" Content="维护模式" Tag="Maintenance" Checked="ModeTabChecked" ToolTip="实心蓝底：PLC实际模式；下划线：当前查看的图。点击只切换查看。"/>
    <RadioButton x:Name="EmergencyTab" Style="{StaticResource EmergencyModeTab}" GroupName="ModeDiagram" Content="急停说明" Tag="Emergency" Checked="ModeTabChecked" ToolTip="实心蓝底：PLC处于急停状态；下划线：当前查看的图。点击只切换查看。"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
    <TextBlock Text="当前模式：" FontSize="16" Foreground="#627A94" Margin="0,0,6,0"/>
    <TextBlock x:Name="CurrentModeValue" Text="{Binding ModeText,Mode=OneWay,FallbackValue=—}" FontSize="26" FontWeight="Bold" Foreground="#125FC5"/>
    <TextBlock Text="当前状态：" FontSize="16" Foreground="#627A94" Margin="24,0,6,0"/>
    <TextBlock x:Name="CurrentStatusValue" Text="{Binding StatusText,Mode=OneWay,FallbackValue=—}" FontSize="26" FontWeight="Bold" Foreground="#125FC5"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="#DAE5F1" BorderThickness="1" CornerRadius="6" Padding="10">
   <!-- 四个图形首次创建后一直保留。小窗口通过图内滚动提供阅读空间，避免按剩余高度缩成小字；大窗口仍自动适配。 -->
   <ScrollViewer x:Name="DiagramScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
   <Grid x:Name="DiagramHost" MinHeight="420" Height="{Binding ViewportHeight,ElementName=DiagramScroll,Mode=OneWay}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="MaintenanceGuideHeader" Visibility="Collapsed" Margin="12,6,12,10">
     <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="MaintenanceIntroTab" GroupName="MaintenancePane" Content="维护说明" Style="{StaticResource ModeTab}" IsChecked="True" Checked="MaintenancePaneChecked"/>
      <RadioButton x:Name="MaintenancePeopleTab" GroupName="MaintenancePane" Content="人员锁管理" Style="{StaticResource ModeTab}" Checked="MaintenancePaneChecked"/>
     </StackPanel>
     <Expander x:Name="MaintenanceInstructions" Header="操作步骤：人员锁管理 → 本人验证上锁／解锁 → 等待 PLC 确认" FontSize="15" Margin="0,8,0,0" IsExpanded="False">
      <StackPanel Margin="0,6,0,0">
      <TextBlock Text="① 进入维护：打开“人员锁管理”，点击“人员上锁”，输入本人用户名和密码；首人上锁后等待 PLC 确认进入维护。" FontSize="17" TextWrapping="Wrap"/>
      <TextBlock Text="② 退出维护：每位人员点击自己一行的“本人解锁”并验证密码；最后一人解锁后，等待 PLC 确认退出，设备才恢复原有操作权限。" FontSize="17" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock Text="管理员可在人员锁管理中验证管理员密码后解除全部锁；维护期间禁止设备操作。下图用于介绍状态切换关系，查看图和切换页签不会改变设备模式。" FontSize="16" Foreground="#526B84" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
     </Expander>
    </StackPanel>
    <ui:ModeStateDiagram Grid.Row="1" x:Name="ManualDiagram" Kind="Manual" Feedback="{Binding Display,Mode=OneWay}" ActionRequested="ModeActionRequested"/>
    <ui:ModeStateDiagram Grid.Row="1" x:Name="AutomaticDiagram" Kind="Automatic" Feedback="{Binding Display,Mode=OneWay}" ActionRequested="ModeActionRequested" Visibility="Collapsed"/>
    <ui:ModeStateDiagram Grid.Row="1" x:Name="MaintenanceDiagram" Kind="Maintenance" Feedback="{Binding Display,Mode=OneWay}" ActionRequested="ModeActionRequested" Visibility="Collapsed"/>
    <ui:ModeStateDiagram Grid.Row="1" x:Name="EmergencyDiagram" Kind="Emergency" Feedback="{Binding Display,Mode=OneWay}" Visibility="Collapsed"/>
    <Grid Grid.Row="1" x:Name="MaintenanceLockPanel" Visibility="Collapsed" Margin="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0">
       <TextBlock Text="维护人员锁管理" FontSize="26" FontWeight="Bold" Foreground="#125FC5"/>
       <TextBlock Text="{Binding MaintenanceSummary,Mode=OneWay}" FontSize="18" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="人员上锁" Click="MaintenanceAddClicked" MinWidth="140" Height="46" FontSize="18"/>
       <Button Content="管理员解除全部锁" Click="MaintenanceAdminUnlockClicked" MinWidth="190" Height="46" FontSize="17" Margin="12,0,0,0" Foreground="#A52A2A">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanAdminUnlock}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
       </Button>
      </StackPanel>
     </Grid>
     <DataGrid Grid.Row="1" ItemsSource="{Binding MaintenancePeople}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" FontSize="18" MinRowHeight="58" HeadersVisibility="Column">
      <DataGrid.Columns>
       <DataGridTextColumn Header="人员" Binding="{Binding UserName,Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="角色" Binding="{Binding RoleName,Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="上锁时间" Binding="{Binding TimeText,Mode=OneWay}" Width="220"/>
       <DataGridTextColumn Header="状态" Binding="{Binding StateText,Mode=OneWay}" Width="220"/>
       <DataGridTemplateColumn Header="操作" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Button Content="本人解锁" Click="MaintenanceUnlockClicked" Tag="{Binding}" MinWidth="120" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="每人独立验证上锁、本人验证解锁；不会切换主界面登录账户。" FontSize="17" TextWrapping="Wrap"/>
      <TextBlock Text="维护期间禁止设备动作及参数下发，可继续查看监控、报警、生产数据和日志。退出登录、断线和重启不自动解除人员锁。" FontSize="16" Foreground="#526B84" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>
   </ScrollViewer>
  </Border>
  <Border x:Name="ModeSignalPanel" Grid.Row="2" Style="{StaticResource Panel}" Padding="16,10" Margin="0,12,0,0">
   <Grid x:Name="ModeSignalGroups">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="#DAE5F1" BorderThickness="0,0,1,0" Padding="0,0,12,0">
     <StackPanel>
      <TextBlock Text="物理按钮／旋钮" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ItemsControl x:Name="PhysicalInputList" ItemsSource="{Binding PhysicalInputs}" ItemTemplate="{StaticResource ModeSignalRow}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" BorderBrush="#DAE5F1" BorderThickness="0,0,1,0" Padding="12,0,12,0">
     <StackPanel>
      <TextBlock Text="界面操作／反馈" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ItemsControl x:Name="InterfaceRequestList" ItemsSource="{Binding InterfaceRequests}" ItemTemplate="{StaticResource ModeRequestRow}"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Column="2" Margin="12,0,0,0">
     <TextBlock Text="PLC 反馈信号" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <ItemsControl x:Name="PlcSignalList" ItemsSource="{Binding PlcSignals}" ItemTemplate="{StaticResource ModeSignalRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
    </StackPanel>
    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#DAE5F1" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
     <TextBlock x:Name="ModeOperationHintText" Text="{Binding ModeOperationHint,Mode=OneWay}" FontSize="15" Foreground="#526B84" TextWrapping="Wrap"/>
    </Border>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,10,0,0">
   <WrapPanel x:Name="ModeLegend">
    <Border Width="28" Height="16" Background="#1765D2" BorderBrush="#104E9C" BorderThickness="1" Margin="0,0,7,0"/><TextBlock Text="True／当前状态" Margin="0,0,22,0"/>
    <Border Width="28" Height="16" Background="White" BorderBrush="#A8B5C4" BorderThickness="1" Margin="0,0,7,0"/><TextBlock Text="未高亮"/>
   </WrapPanel>
   <TextBlock Text="{Binding Message,Mode=OneWay,FallbackValue=模式控制绑定尚未加载。}" Foreground="#627A94" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding OperationMessage,Mode=OneWay}" Foreground="#1765D2" FontSize="14" TextWrapping="Wrap"/>
   <Expander Header="状态与操作说明" FontSize="15" IsExpanded="False" Margin="0,6,0,0">
    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
     <TextBlock TextWrapping="Wrap" Margin="0,6,12,0" Foreground="#526B84">
      <Run Text="运行继续校验与初始化完成均来自PLC反馈。单次结束 b_Signal[3]、停止按钮或旋钮手动任一成立，运行返回停止；PLC 在停止状态复位单次结束信号。"/><LineBreak/>
      <Run Text="维护由每人分别验证上锁、解锁；退出主账户不会解除人员锁。最后一人解锁后先回停止，再按当前故障、暂停等条件重判。"/><LineBreak/>
      <Run Text="暂停解除先回停止；运行、调试、初始化请求保持有效时，会再次参与判断。急停状态与停止状态本身都不代表机构已经停稳，实际停稳及安全复位需另行确认。"/>
     </TextBlock>
    </ScrollViewer>
   </Expander>
  </StackPanel>
 </Grid>
</UserControl>
