<UserControl x:Class="Company.Application.Main.Views.CylinderParameterView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:prism="http://prismlibrary.com/" xmlns:ui="clr-namespace:Company.Application.Main.Presentation"
 prism:ViewModelLocator.AutoWireViewModel="True" Background="#F0F5FB" FontFamily="Segoe UI, Microsoft YaHei" FontSize="15">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Company.Application.Main;component/Presentation/PreviewPageStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="CylinderVisibility"/>
  <Style x:Key="CylinderLamp" TargetType="Ellipse">
   <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Fill" Value="#BCC7D3"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Tag.State,RelativeSource={RelativeSource Self},FallbackValue=未配置,TargetNullValue=未配置}"/>
   <Style.Triggers><DataTrigger Binding="{Binding Tag.DisplayBooleanValue,RelativeSource={RelativeSource Self},FallbackValue={x:Null},TargetNullValue={x:Null}}" Value="True"><Setter Property="Fill" Value="#159947"/></DataTrigger><DataTrigger Binding="{Binding Tag.DisplayBooleanValue,RelativeSource={RelativeSource Self},FallbackValue={x:Null},TargetNullValue={x:Null}}" Value="False"><Setter Property="Fill" Value="#8795A4"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="CylinderButton" TargetType="Button" BasedOn="{StaticResource StableStateButton}">
   <Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="IsEnabled" Value="{Binding CanUseControls}"/>
  </Style>
  <Style x:Key="CylinderDirectionButton" TargetType="Button" BasedOn="{StaticResource CylinderButton}">
   <Setter Property="ToolTip" Value="{Binding CommandParameter.State,RelativeSource={RelativeSource Self},FallbackValue=等待采集,TargetNullValue=等待采集}"/>
   <Style.Triggers><DataTrigger Binding="{Binding CommandParameter.DisplayBooleanValue,RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="#159947"/><Setter Property="BorderBrush" Value="#159947"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="CylinderInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="Text" Value="{Binding Edit.Draft,Mode=OneWay}"/><Setter Property="Height" Value="44"/>
   <Setter Property="FontSize" Value="22"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="#223E5E"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="{Binding Edit.Result}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Padding="0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/></Border></ControlTemplate></Setter.Value></Setter>
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ParameterPressed"/><EventSetter Event="PreviewKeyDown" Handler="ParameterKeyDown"/>
  </Style>
  <DataTemplate x:Key="CylinderNumericValue"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Value,FallbackValue=—,TargetNullValue=—}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="15"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="CylinderTableValue"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding State}"><TextBlock Text="{Binding Value,FallbackValue=—,TargetNullValue=—}" FontSize="17"/><TextBlock Text="{Binding Unit}" FontSize="15" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="CylinderDelayInput"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource CylinderInput}"/><TextBlock Grid.Column="1" Text="{Binding Unit}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></DataTemplate>
  <Style x:Key="CylinderCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DAE5F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="88"/></Style>
  <Style x:Key="CylinderCardLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#627A94"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,18">
  <Border BorderBrush="#DAE5F1" BorderThickness="0,0,0,1" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SubnavButton}" Content="轴参数" ui:PreviewNavigation.Target="AxisParameterView"/><Button Style="{StaticResource SubnavButton}" Content="气缸参数" Tag="current" ui:PreviewNavigation.Target="CylinderParameterView"/></StackPanel></Border>
  <Border Style="{StaticResource Toolbar}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="设备" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="235"/></StackPanel>
   <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Button Content="❮" Click="PreviousComponentClicked" Margin="0,0,8,0" ToolTip="上一个气缸"/><ComboBox Grid.Column="1" ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}"/><Button Grid.Column="2" Content="❯" Click="NextComponentClicked" Margin="8,0,0,0" ToolTip="下一个气缸"/></Grid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,6,0"><Ellipse Width="14" Height="14" Fill="{Binding StateColor}" Margin="0,0,12,0"/><TextBlock Text="{Binding CurrentState}" FontWeight="SemiBold" FontSize="17"/></StackPanel>
  </Grid></Border>
  <UniformGrid Columns="4" Margin="-4,0,-4,10">
   <Border Style="{StaticResource CylinderCard}"><Border BorderBrush="#1765D2" BorderThickness="4,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="气缸名称" Style="{StaticResource CylinderCardLabel}"/><TextBlock Text="{Binding SelectedComponent.Name,FallbackValue=—,TargetNullValue=—}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Border></Border>
   <Border Style="{StaticResource CylinderCard}"><Border BorderBrush="{Binding StateColor}" BorderThickness="4,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="当前状态" Style="{StaticResource CylinderCardLabel}"/><TextBlock Text="{Binding CurrentState}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border></Border>
   <Border Style="{StaticResource CylinderCard}"><Border BorderBrush="#1765D2" BorderThickness="4,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="缩回耗时" Style="{StaticResource CylinderCardLabel}"/><ContentControl Content="{Binding Retract.Elapsed}" ContentTemplate="{StaticResource CylinderNumericValue}"/></StackPanel></Border></Border>
   <Border Style="{StaticResource CylinderCard}"><Border BorderBrush="#1765D2" BorderThickness="4,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="伸出耗时" Style="{StaticResource CylinderCardLabel}"/><ContentControl Content="{Binding Extend.Elapsed}" ContentTemplate="{StaticResource CylinderNumericValue}"/></StackPanel></Border></Border>
  </UniformGrid>
  <Border Style="{StaticResource Panel}" Padding="24,20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width=".8*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="手动操作" Style="{StaticResource SectionTitle}" FontSize="19" Margin="0,0,0,14"/><UniformGrid Columns="3" Margin="0,0,-10,14"><Button Content="缩回" Style="{StaticResource CylinderDirectionButton}" Tag="Retract" CommandParameter="{Binding Retract.CommandFeedback}" Click="OperationClicked"/><Button Content="伸出" Style="{StaticResource CylinderDirectionButton}" Tag="Extend" CommandParameter="{Binding Extend.CommandFeedback}" Click="OperationClicked"/><Button Content="报警复位" Style="{StaticResource CylinderButton}" Tag="Reset" Click="OperationClicked"/></UniformGrid>
    <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><Ellipse Tag="{Binding Retract.Sensor}" Style="{StaticResource CylinderLamp}"/><TextBlock Text="缩回输入" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Ellipse Tag="{Binding Extend.Sensor}" Style="{StaticResource CylinderLamp}"/><TextBlock Text="伸出输入" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal"><Ellipse Tag="{Binding Retract.Complete}" Style="{StaticResource CylinderLamp}"/><TextBlock Text="缩回完成" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><Ellipse Tag="{Binding Extend.Complete}" Style="{StaticResource CylinderLamp}"/><TextBlock Text="伸出完成" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="{Binding HasAlarmFeedback,Converter={StaticResource CylinderVisibility}}"><Ellipse Tag="{Binding Retract.Alarm}" Style="{StaticResource CylinderLamp}"/><TextBlock Text="缩回报警" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasAlarmFeedback,Converter={StaticResource CylinderVisibility}}"><Ellipse Tag="{Binding Extend.Alarm}" Style="{StaticResource CylinderLamp}"/><TextBlock Text="伸出报警" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    </Grid>
   </StackPanel>
   <Border Grid.Column="1" Background="#DAE5F1" Width="1" Margin="0,6"/>
   <StackPanel Grid.Column="2"><TextBlock Text="动作延时" Style="{StaticResource SectionTitle}" FontSize="19" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions>
    <TextBlock Text="缩回到位延时" VerticalAlignment="Center"/><ContentControl Grid.Column="1" Content="{Binding Retract.ArrivalDelay}" ContentTemplate="{StaticResource CylinderDelayInput}"/>
    <TextBlock Grid.Row="1" Text="缩回报警延时" VerticalAlignment="Center"/><ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Retract.AlarmDelay}" ContentTemplate="{StaticResource CylinderDelayInput}"/>
    <TextBlock Grid.Row="2" Text="伸出到位延时" VerticalAlignment="Center"/><ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding Extend.ArrivalDelay}" ContentTemplate="{StaticResource CylinderDelayInput}"/>
    <TextBlock Grid.Row="3" Text="伸出报警延时" VerticalAlignment="Center"/><ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding Extend.AlarmDelay}" ContentTemplate="{StaticResource CylinderDelayInput}"/>
   </Grid></StackPanel>
  </Grid></Border>
  <Border Style="{StaticResource Note}" Margin="0,0,0,14"><DockPanel><TextBlock Text="气缸操作" FontWeight="SemiBold" Margin="0,0,14,0"/><TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap"/></DockPanel></Border>
  <TextBlock Text="方向状态与参数" Style="{StaticResource SectionTitle}" FontSize="19" Margin="0,0,0,12"/>
  <Border Style="{StaticResource Panel}" MinHeight="300"><DataGrid x:Name="CylinderDirections" ItemsSource="{Binding Directions}" RowHeight="56" HeadersVisibility="Column" VerticalAlignment="Top"><DataGrid.Resources><Style TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource {x:Type primitives:DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGrid.Resources><DataGrid.Columns>
   <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   <DataGridTemplateColumn Header="命令" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Tag="{Binding CommandFeedback}" Style="{StaticResource CylinderLamp}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="输入" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Tag="{Binding Sensor}" Style="{StaticResource CylinderLamp}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="完成" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Tag="{Binding Complete}" Style="{StaticResource CylinderLamp}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn x:Name="CylinderAlarmColumn" Header="报警" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Tag="{Binding Alarm}" Style="{StaticResource CylinderLamp}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="动作耗时" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Elapsed}" ContentTemplate="{StaticResource CylinderTableValue}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="到位延时" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding ArrivalDelay}" ContentTemplate="{StaticResource CylinderTableValue}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="报警延时" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding AlarmDelay}" ContentTemplate="{StaticResource CylinderTableValue}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid></Border>
 </StackPanel></ScrollViewer>
</UserControl>