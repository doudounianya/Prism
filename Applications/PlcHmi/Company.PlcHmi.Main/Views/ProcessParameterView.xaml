<UserControl x:Class="Company.PlcHmi.Main.Views.ProcessParameterView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:prism="http://prismlibrary.com/" xmlns:hmi="clr-namespace:Company.Hmi.Presentation;assembly=Company.Hmi.Presentation" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 prism:ViewModelLocator.AutoWireViewModel="True" Background="#F0F5FB" FontFamily="Segoe UI, Microsoft YaHei" FontSize="15">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Company.PlcHmi.Main;component/Presentation/PreviewPageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <hmi:ProcessWorkspace><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,18">
<Border Style="{StaticResource Toolbar}"><WrapPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6"><TextBlock Text="设备" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="185"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6"><TextBlock Text="工位 / 平台" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox ItemsSource="{Binding Contexts}" SelectedItem="{Binding SelectedContext}" Width="140"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6"><TextBlock Text="参数类别" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="150"/></StackPanel><Button Content="刷新当前阶段" Style="{StaticResource Primary}" Click="RefreshClicked" IsEnabled="{Binding CanRefresh}"/></WrapPanel></Border><UniformGrid Columns="4"><Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="当前查看配方" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedRecipe}" Style="{StaticResource MetricValue}"/><TextBlock Text="配置中的配方库" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="PLC 生效版本" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ActiveRevision.Value,TargetNullValue=—,FallbackValue=—}" Style="{StaticResource MetricValue}"/><TextBlock Text="当前页面读取" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="编辑版本" Style="{StaticResource Muted}"/><TextBlock Text="—" Style="{StaticResource MetricValue}"/><TextBlock Text="草稿功能未接入" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="当前阶段" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedPhase}" Style="{StaticResource MetricValue}"/><TextBlock Text="PRE 与 FULL 分别配置" Style="{StaticResource Muted}"/></StackPanel></Border></UniformGrid><Grid x:Name="RecipeLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width=".85*" MinWidth="300"/></Grid.ColumnDefinitions>
 <ContentControl x:Name="RecipeLibrary" ContentTemplate="{x:Null}" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource Panel}" ><StackPanel><Border Style="{StaticResource PanelHead}"><TextBlock Text="配方库" Style="{StaticResource SectionTitle}"/></Border><ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" MinHeight="120" Margin="6,8"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding}" FontWeight="SemiBold"/><TextBlock Text="配置配方 · 只读查看" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Margin="14"><Button Content="查看版本差异" IsEnabled="False"/><Border Style="{StaticResource Note}" ><TextBlock Text="PLC 生效配方" Style="{StaticResource Muted}" TextWrapping="Wrap"/></Border><TextBlock Text="{Binding ActiveRecipe.Value,TargetNullValue=—,FallbackValue=—}" Margin="0,8,0,0"/><Border Style="{StaticResource Note}" ><TextBlock Text="切换查看配方不改变 PLC 生效配方。" Style="{StaticResource Muted}" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border></ContentControl>
 <ContentControl x:Name="RecipeRoute" Grid.Column="2" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource Panel}" ><StackPanel><Border Style="{StaticResource PanelHead}"><TextBlock Text="工艺路线与轨迹预览" Style="{StaticResource SectionTitle}"/></Border><StackPanel Margin="16"><WrapPanel><Button Content="只预焊" IsEnabled="False"/><Button Content="预焊＋满焊" IsEnabled="False"/></WrapPanel>
 <Border Background="#FFF6E8" CornerRadius="5" Padding="12,10" Margin="0,12,0,0"><TextBlock Text="轨迹来源及路线代码映射未确认；本页只读，暂不开放路线切换。" Foreground="#8C601D" FontSize="15" TextWrapping="Wrap"/></Border>
 <Border Height="340" Background="#F8FBFF" BorderBrush="#E2EBF5" BorderThickness="1" CornerRadius="6" Margin="0,12,0,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="轨迹数据未配置" FontSize="16" HorizontalAlignment="Center" Foreground="#617B97"/><TextBlock Text="等待已确认的轨迹数据来源" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border>
 <WrapPanel Margin="0,12,0,12"><Border Style="{StaticResource Badge}" Background="#FFF3DE"><TextBlock Text="橙色：PRE" Foreground="#936014" FontSize="15"/></Border><Border Style="{StaticResource Badge}"><TextBlock Text="蓝色：FULL" Foreground="#1765D2" FontSize="15"/></Border></WrapPanel>
 <TextBlock Text="PLC 生效信息" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
 <ItemsControl ItemsSource="{Binding CommonFields}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5" ToolTip="{Binding LogicalId}"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" TextWrapping="Wrap"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Value}"/><TextBlock Text="{Binding State}" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></StackPanel></Border></ContentControl>
 <!-- 右侧按共同内容行的高度拉伸；阶段参数按内容布局，质量规则面板填满剩余高度，与路线/配方库底部对齐。 -->
 <ContentControl x:Name="RecipeDetails" Grid.Column="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Panel}" ><StackPanel><Border Style="{StaticResource PanelHead}"><TextBlock Text="阶段参数" Style="{StaticResource SectionTitle}"/></Border><StackPanel Margin="16">
 <ListBox ItemsSource="{Binding Phases}" SelectedItem="{Binding SelectedPhase}" Margin="0,0,0,12"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
 <ItemsControl ItemsSource="{Binding PageFields}" ItemTemplate="{StaticResource ParameterForm}"/>
 </StackPanel></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0"><StackPanel><Border Style="{StaticResource PanelHead}"><TextBlock Text="质量规则引用" Style="{StaticResource SectionTitle}"/></Border><StackPanel Margin="16"><TextBlock Text="LWM 规则　　未配置" Style="{StaticResource Muted}"/><TextBlock Text="检测扩展　　 未配置" Style="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="视觉配合标准　待确认" Style="{StaticResource Muted}" Margin="0,12,0,16"/><WrapPanel><Button Content="保存草稿" Style="{StaticResource Primary}" IsEnabled="False"/><Button Content="提交审核 · 预览" IsEnabled="False"/><Button Content="发布到设备" IsEnabled="False"/></WrapPanel><Border Style="{StaticResource Note}" ><TextBlock Text="本批只读查看；草稿、审批和发布尚未接入。" Style="{StaticResource Muted}" TextWrapping="Wrap"/></Border></StackPanel></StackPanel></Border></Grid></ContentControl>
 </Grid><Border Style="{StaticResource Note}" ><TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" TextWrapping="Wrap"/></Border><TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Diagnostics}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
</hmi:ProcessWorkspace>
</UserControl>
