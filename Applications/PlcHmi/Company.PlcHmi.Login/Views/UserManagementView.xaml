<UserControl x:Class="Company.PlcHmi.Login.Views.UserManagementView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:Company.PlcHmi.Login.Presentation" xmlns:prism="http://prismlibrary.com/"
 prism:ViewModelLocator.AutoWireViewModel="True" Width="1000" Height="650" FontFamily="Segoe UI, Microsoft YaHei" FontSize="16" Background="#F0F5FB">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Company.PlcHmi.Login;component/Presentation/AccountStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="用户列表" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser,Mode=TwoWay}">
     <DataGrid.Columns><DataGridTextColumn Header="用户名" Binding="{Binding UserName,Mode=OneWay}" Width="*"/><DataGridTextColumn Header="类别" Binding="{Binding RoleName,Mode=OneWay}" Width="145"/><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt,Mode=OneWay,StringFormat=yyyy-MM-dd HH:mm}" Width="165"/></DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="更新列表" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/><Button Content="删除选中用户" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanReset}"/></StackPanel>
   </Grid>
   <TabControl Grid.Column="2" FontSize="17" Padding="12" Background="White" BorderBrush="#DAE5F1">
    <TabItem Header="创建用户" FontSize="17"><StackPanel Margin="0,12,0,0">
    <TextBlock Text="用户名" Margin="0,0,0,4"/><TextBox Text="{Binding NewUserName,UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
    <TextBlock Text="用户类别" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedRole,Mode=TwoWay}"/>
    <TextBlock Text="密码" Margin="0,8,0,4"/><PasswordBox p:PasswordBinding.Password="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/>
    <TextBlock Text="确认密码" Margin="0,8,0,4"/><PasswordBox p:PasswordBinding.Password="{Binding Confirmation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/>
    <Button Content="创建用户" Command="{Binding CreateCommand}" Style="{StaticResource Primary}" Margin="0,12,0,20"/>
    </StackPanel></TabItem>
    <TabItem Header="重置密码" FontSize="17"><StackPanel Margin="0,12,0,0">
     <TextBlock Text="重置选中用户密码" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding SelectedUser.UserName,Mode=OneWay}" Margin="0,8,0,8"/>
     <StackPanel IsEnabled="{Binding CanReset}"><TextBlock Text="新密码" Margin="0,0,0,4"/><PasswordBox p:PasswordBinding.Password="{Binding ResetPassword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/>
      <TextBlock Text="确认新密码" Margin="0,8,0,4"/><PasswordBox p:PasswordBinding.Password="{Binding ResetConfirmation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/>
      <Button Content="重置密码" Command="{Binding ResetPasswordCommand}" Margin="0,12,0,0"/>
     </StackPanel>
     <TextBlock Text="本人密码请从右上角账号入口修改，并验证原密码。" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel></TabItem>
   </TabControl>
  </Grid>
  <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" MinHeight="44" Margin="0,14,0,8"/>
  <Button Grid.Row="2" Content="关闭" Command="{Binding CloseCommand}" HorizontalAlignment="Right"/>
 </Grid>
</UserControl>
