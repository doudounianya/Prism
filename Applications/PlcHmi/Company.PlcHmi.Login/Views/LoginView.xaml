<UserControl x:Class="Company.PlcHmi.Login.Views.LoginView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:prism="http://prismlibrary.com/" xmlns:p="clr-namespace:Company.PlcHmi.Login.Presentation"
 prism:ViewModelLocator.AutoWireViewModel="True" mc:Ignorable="d" FontFamily="Segoe UI, Microsoft YaHei" FontSize="15"
 Foreground="#223E5E" Background="White" d:DesignHeight="336" d:DesignWidth="520">
 <UserControl.Resources>
  <!-- 样式只作用于登录页，不改变全局控件、认证流程或主窗口框架。内边距只在边框应用一次，避免文字裁切。 -->
  <Style x:Key="LoginTextInput" TargetType="TextBox">
   <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#223E5E"/><Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DAE5F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5">
     <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Padding="0" Margin="0" VerticalAlignment="Center" Focusable="False"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#1765D2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#88AEE7"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LoginPasswordInput" TargetType="PasswordBox">
   <Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#223E5E"/><Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DAE5F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5">
     <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Padding="0" Margin="0" VerticalAlignment="Center" Focusable="False"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#1765D2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#88AEE7"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#526985"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#526985"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </UserControl.Resources>
 <Border Background="White" BorderBrush="#DAE5F1" BorderThickness="1" MouseLeftButtonDown="DragBlankArea">
 <Grid Margin="24,16,24,12">
  <!-- 表单与窗口使用同一白色背景，移除外层蓝色留白和内外双重卡片边界。 -->
  <ScrollViewer Style="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
   <Border x:Name="LoginCard" MaxWidth="480" VerticalAlignment="Center" Background="White" BorderThickness="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,14">
      <TextBlock Text="账号登录" FontSize="24" FontWeight="SemiBold" Foreground="#173D6B" VerticalAlignment="Center"/>
      <!-- 关闭仍调用原宿主 Closing，继续使用最小化到托盘/取消/关闭程序三选一流程。 -->
      <Button x:Name="CloseLoginButton" Content="×" Width="32" Height="32" FontSize="25" HorizontalAlignment="Right" ToolTip="关闭" Click="CloseLoginClicked">
       <Button.Style><Style TargetType="Button"><Setter Property="Foreground" Value="#627A94"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#FFF0F0"/><Setter Property="Foreground" Value="#C22B2B"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></Button.Style>
      </Button>
     </Grid>
     <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource 用户名}" VerticalAlignment="Center"/>
      <TextBox x:Name="UserNameInput" Grid.Column="1" Style="{StaticResource LoginTextInput}" Text="{Binding UserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
     </Grid>
     <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource 密码}" VerticalAlignment="Center"/>
      <Grid Grid.Column="1">
       <PasswordBox x:Name="PasswordInput" p:PasswordBinding.Password="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
        <PasswordBox.Style><Style TargetType="PasswordBox" BasedOn="{StaticResource LoginPasswordInput}"><Style.Triggers><DataTrigger Binding="{Binding ShowPassword}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></PasswordBox.Style>
       </PasswordBox>
       <TextBox x:Name="VisiblePasswordInput" Text="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource LoginTextInput}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowPassword}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
       </TextBox>
      </Grid>
     </Grid>
     <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="ShowPasswordOption" Content="显示密码" IsChecked="{Binding ShowPassword,Mode=TwoWay}"/>
      <CheckBox x:Name="RememberOption" Grid.Column="1" Content="记住密码" HorizontalAlignment="Center" IsChecked="{Binding IsRemember,Mode=TwoWay}"/>
      <CheckBox x:Name="AutoLoginOption" Grid.Column="2" Content="自动登录" HorizontalAlignment="Right" IsChecked="{Binding IsAutoLogin,Mode=TwoWay}"/>
     </Grid>
     <Button x:Name="LoginButton" Grid.Row="4" Command="{Binding LoginCommand}" Height="42" Margin="0,14,0,0" IsDefault="True">
      <Button.Style><Style TargetType="Button">
       <Setter Property="Content" Value="登录"/><Setter Property="FontSize" Value="17"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1765D2"/><Setter Property="BorderThickness" Value="0"/>
       <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#2376E5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1256B8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Background" Value="#88AEE7"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
       <Style.Triggers><DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="Content" Value="正在登录…"/></DataTrigger></Style.Triggers>
      </Style></Button.Style>
     </Button>
     <!-- 语言紧跟登录按钮，不固定在窗口底部；空状态文字不再占据一块空白。 -->
     <StackPanel x:Name="LanguageOptions" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
      <RadioButton x:Name="CN" Content="简体" IsChecked="True"/><RadioButton x:Name="TW" Content="繁体"/><RadioButton x:Name="US" Content="英语"/>
     </StackPanel>
     <TextBlock x:Name="LoginStatus" Grid.Row="6" Text="{Binding StatusMessage}" Margin="0,6,0,0" FontSize="13" Foreground="#526985" TextWrapping="Wrap">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
       <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
       <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </Border>
  </ScrollViewer>
 </Grid>
 </Border>
</UserControl>
