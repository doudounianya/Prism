<UserControl x:Class="Company.PlcHmi.Configuration.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hmi="clr-namespace:Company.Hmi.Presentation;assembly=Company.Hmi.Presentation"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="600" Height="380" FontFamily="Segoe UI, Microsoft YaHei" FontSize="16" Background="#F0F5FB">
    <UserControl.Resources>
        <ResourceDictionary Source="/Company.Hmi.Presentation;component/SettingsPageStyles.xaml"/>
    </UserControl.Resources>
    <hmi:SettingsPage>
        <hmi:SettingsPage.SoftwareContent>
            <Border Style="{StaticResource SettingsCard}">
                    <StackPanel IsEnabled="{Binding IsAdministrator}">
                        <TextBlock Text="软件名称" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBox Text="{Binding SystemConfigManager.Config.SoftwareConfig.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>
        </hmi:SettingsPage.SoftwareContent>
        <hmi:SettingsPage.AccountContent>
            <StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid MinHeight="50">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="本人密码" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="验证原密码后修改。" Foreground="#627A94" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="修改密码" Command="{Binding ChangePasswordCommand}" Width="112" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- 整行沿用原管理员入口的可见性，命令内继续执行原有权限复核。 -->
                    <Border Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsAdministrator}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid MinHeight="50">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="用户管理" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="创建、删除用户及重置密码。" Foreground="#627A94" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="管理用户" Command="{Binding UserManagementCommand}" Width="112" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
        </hmi:SettingsPage.AccountContent>
        <hmi:SettingsPage.Actions>
            <Border BorderBrush="#DAE5F1" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource 取消}" IsCancel="True" Margin="0,0,12,0"/>
                <Button Content="{DynamicResource 确定}" Command="{Binding OKCommand}" Style="{StaticResource SettingsPrimary}"/>
            </StackPanel>
        </Border>
        </hmi:SettingsPage.Actions>
    </hmi:SettingsPage>
</UserControl>
